Algoritmo Operadores_Aritmeticos_ejer1
//Escribe un programa que: Pida dos números al usuario
//Calcule su suma Calcule su multiplicación Muestre ambos resultados
	
	//Variables
	Definir Num1 Como Entero
	Definir Num2 Como Entero
	Definir Suma Como Entero
	Definir Multiplicacion Como Entero
	
	Escribir "Digite un numero"
	Leer Num1
	Escribir "Digite otro numero"
	Leer Num2
	
	Suma = Num1 + Num2
	Multiplicacion = Num1 * Num2
	
	Escribir "El Resultado de la suma de los dos numero es: " Suma
	Escribir "El Resultado de la Multiplicacion de los dos numero es: " Multiplicacion
FinAlgoritmo
