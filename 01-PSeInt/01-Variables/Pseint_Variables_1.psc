Algoritmo Variables_Pseint_1
	//Zona de definicion de Varibles
	Definir Nombre Como Caracter
	Definir Apellido Como Caracter
	Definir edad Como Entero
	Definir edadDuplicada Como entero
	
	Escribir "dime tu Nombre"
	leer Nombre
	Escribir "dime tu Apellido"
	leer Apellido
	Escribir "dime tu edad"
	leer edad
	
	edadDuplicada = edad * 2
	
	Escribir "Hola Bienvenido:" Nombre " " Apellido
	Escribir "Tu edad duplicada es:" edadDuplicada
FinAlgoritmo
