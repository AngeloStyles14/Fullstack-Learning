Algoritmo Operaciones_con_cadenas_ejer2
	//Leer nombre y ciudad y mostrar: Hola Marta, vives en Valencia
	
	//Variables
	Definir nombre, Ciudad, Saludo Como Caracter
	
	Escribir "Escribe tu Nombre: "
	Leer nombre
	Escribir "En que ciudad vives: "
	Leer Ciudad
	
	Saludo = "Hola " + nombre + ", vives en " + Ciudad
	
	Escribir Saludo
	
FinAlgoritmo