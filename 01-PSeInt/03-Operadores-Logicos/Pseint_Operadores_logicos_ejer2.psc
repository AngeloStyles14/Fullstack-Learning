Algoritmo Operadores_logicos_ejer2
//Pida un número, Muestre si el número está entre 10 y 20 (incluidos)
	
	//Variables
	Definir Num Como Entero
	Definir NumEntre Como Logico
	
	Escribir "Digite un Numero"
	Leer Num
	
	NumEntre = Num >= 10 y Num <= 20
	
	Escribir "El Numero que digito esta entre 10 y 20 : " NumEntre
FinAlgoritmo
